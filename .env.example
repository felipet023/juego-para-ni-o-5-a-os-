# ─────────────────────────────────────────────────────────────
# SQLQuest 3D — plantilla de variables de entorno
# Copia este archivo a `.env` y rellena los valores reales.
# NUNCA subas `.env` al repositorio.
# ─────────────────────────────────────────────────────────────

# Entorno: development | test | production
NODE_ENV=development

# Puerto de la API
PORT=4000

# Origen exacto del frontend (para CORS y comprobación de CSRF).
# En producción usa tu dominio real con https://
APP_ORIGIN=http://localhost:5173

# ─── MySQL ───────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sqlquest_dev
DB_PASSWORD=cambia-esta-clave
DB_NAME=sqlquest_app

# Base de datos del laboratorio infantil (datos ficticios reiniciables).
# La cuenta de la app solo tiene SELECT/INSERT/UPDATE/DELETE aquí.
LAB_DB_NAME=sqlquest_lab

# ─── Sesiones ────────────────────────────────────────────────
# Cadena aleatoria larga (mínimo 32 caracteres). Genérala con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=cambia-esta-cadena-por-una-aleatoria-larga

# ─── Cuenta de administración inicial ────────────────────────
# Se crea solo si no existe. Cámbiala antes de publicar el juego.
ADMIN_USERNAME=profe
ADMIN_PASSWORD=cambia-esta-clave-de-admin

# ─── Límites de seguridad ────────────────────────────────────
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
